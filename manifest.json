{
  "manifest_version": 3,
  "name": "Tóm tắt CLS",
  "version": "1.2.0",
  "description": "Tiện ích tóm tắt và quét nhanh kết quả Cận lâm sàng.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://qtrungyb.github.io/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Mở Tóm tắt CLS"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
