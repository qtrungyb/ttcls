{
  "manifest_version": 3,
  "name": "Tóm tắt CLS",
  "version": "1.2.1",
  "description": "Tự động quét dữ liệu cho trang Tóm tắt CLS",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://qtrungyb.github.io/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Mở Tóm tắt CLS",
    "default_icon": "icon.png"
  }
}