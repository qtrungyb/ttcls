{
  "manifest_version": 3,
  "name": "Tóm tắt CLS",
  "version": "1.0.1",
  "description": "Tiện ích tóm tắt và format nhanh kết quả Cận lâm sàng trực tiếp trên trình duyệt.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mở Tóm tắt CLS"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
